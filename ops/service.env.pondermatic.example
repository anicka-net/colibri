# Pondermatic: one GB10 Spark, native NVFP4 compact snapshot, FP8 KV shadows.
# The engine's format-aware RAM guard lowers COLI_CAP to the largest value that
# fits a 32k context under the automatic 88% MemAvailable budget, maximizing the
# expert LRU while retaining a useful programming-session context.

COLI_MODEL=/home/claudia/models/SuperGLM-5.2-abliterated-NVFP4-506e95b9.aligned-v2-local/compact
COLI_ENGINE=/home/claudia/colibri-production/c/colibri
COLI_HOST=0.0.0.0
COLI_PORT=8000
COLI_MODEL_ID=glm-5.2-nvfp4-compact
COLI_CONTEXT=32768
COLI_MAX_TOKENS=16384
COLI_CAP=256
COLI_KV_SLOTS=1
COLI_EXPERT_BITS=4
COLI_DENSE_BITS=8
COLI_CORS_ORIGIN=*

COLI_CUDA=1
CUDA_DENSE=1
COLI_CUDA_HOST_EXPERTS=1
CUDA_EXPERT_GB=0
CUDA_RELEASE_HOST=0
COLI_CUDA_PIPE=2
COLI_CUDA_PIPE_S_MIN=1
COLI_CUDA_PREFILL=0
COLI_CUDA_TC_W4A16=1
COLI_NVFP4_NATIVE=1
COLI_NVFP4_NATIVE_MIN_ROWS=1

COLI_KV_DTYPE=fp8
COLI_KV_SHARE=0
COLI_DSA_REFRESH=1
COLI_DSA_DECODE_TCGATHER=1
COLI_DSA_TCGATHER=1
COLI_SERVE_ALL_STOPS=1

AUTOPIN=0
DIRECT=1
URING=1
PIPE=1
PIPE_WORKERS=10
PILOT_REAL=0
PILOT_TWO=0
PILOT_K=6
DRAFT=0
CACHE_ROUTE=0
CAP_RAISE=0
COLI_ADAPTIVE_CAP=0
COLI_KV_CACHE_GB=0
KVSAVE=0

PROF=1
COLI_DBG_DSACHAIN=1
OMP_NUM_THREADS=10
OMP_PLACES=cores
OMP_PROC_BIND=spread

COLI_PREFLIGHT_MIN_SHARDS=45
COLI_PREFLIGHT_MIN_GB=390
COLI_PREFLIGHT_NEED_IDX=1
COLI_PREFLIGHT_UVM_HMM=1

COLI_WATCHDOG_MODEL=glm-5.2-nvfp4-compact
COLI_WATCHDOG_WARMUP_SECONDS=180
COLI_WATCHDOG_PROBE_TIMEOUT=30
